# ============================================================
#  复制成 .env.local 再填。.env.local 已被 gitignore。
#  改完需要重启 dev server（Vite 只在启动时读一次）。
#
#  一期链路：文本 → DeepSeek（输入层）→ Jev（判断层）→ Act IR → three-vrm
#  二期把输入层换成 gpt-live-1 的实时语音，右边全不动。
# ============================================================


# ------------------------------------------------------------
# 判断层：Jev —— 决定"怎么演"
# ------------------------------------------------------------
# 同一个模型有三种接法，后端按 key 前缀自动识别，通常不用管：
#
#   vck_…  Vercel AI Gateway   → https://ai-gateway.vercel.sh/typesafe
#                                key 在 vercel.com 的 AI Gateway 里拿
#   sk_…   JevStation          → https://jevstation.com
#                                key 在 JevStation 的 Settings 里创建
#   其它    TypeSafe 官方直连    → https://api.typesafe.ai
#                                候补名单，console.typesafe.ai/settings/keys
#
# Jev 是判断模型，**不生成文本**，只回答类型化问题（choice / score / noul）。
# 它给出的是情绪概率分布、强度、视线、待机基调、要不要中途移开视线。

JEV_KEY=vck_...

# 下面三个一般不用填，自动识别的结果不对时才覆盖
# JEV_BACKEND=vercel          # vercel | jevstation | typesafe
# JEV_BASE_URL=               # 自部署或自建网关时改
# JEV_MODEL=typesafe-ai/jev   # Vercel 必须带；JevStation 会忽略


# ------------------------------------------------------------
# 输入层：DeepSeek —— 决定"说什么"
# ------------------------------------------------------------
# 一期用它替代实时语音交互。人设写在 server/persona.md。
# 不配的话回落到前端的规则模板（能跑，但台词是写死的）。

DEEPSEEK_API_KEY=sk-...

# 可选。默认 deepseek-flash —— 实时对话里延迟直接决定观感。
# 要更好的对话质量可以换 deepseek-v4-pro，代价是慢。
# DEEPSEEK_MODEL=deepseek-flash

# 可选。默认不发 thinking / reasoning_effort，走最朴素的兼容形状。
# 填了才会开推理（会明显变慢，对话场景一般不需要）。
# DEEPSEEK_REASONING_EFFORT=high

# 可选，自建网关时改
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。强制用规则模板，不走 DeepSeek（想对比时用）
# JEV_SPEECH=draft


# ------------------------------------------------------------
# 替代方案：你自己的 HTTP 服务（输入层+判断层都自己做）
# ------------------------------------------------------------
# 契约：POST {input, history, draft} -> ActScript（见 src/act/schema.ts）
# UI 右侧「Act IR 契约」面板有完整字段说明。

# JEV_MODE=passthrough
# JEV_ENDPOINT=http://localhost:8787/act
# JEV_API_KEY=
# JEV_AUTH_HEADER=Authorization
