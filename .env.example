# ============================================================
#  复制成 .env.local 再填。.env.local 已被 gitignore。
#  改完需要重启 dev server（Vite 只在启动时读一次）。
#
#  一期链路：文本 → DeepSeek（输入层）→ Jev（判断层）→ Act IR → three-vrm
#  二期把输入层换成 gpt-live-1 的实时语音，右边全不动。
# ============================================================


# ------------------------------------------------------------
# 判断层：Jev —— 决定"怎么演"
# ------------------------------------------------------------
# 同一个模型有三种接法，后端按 key 前缀自动识别，通常不用管：
#
#   vck_…  Vercel AI Gateway   → https://ai-gateway.vercel.sh/typesafe
#                                key 在 vercel.com 的 AI Gateway 里拿
#   sk_…   JevStation          → https://jevstation.com
#                                key 在 JevStation 的 Settings 里创建
#   其它    TypeSafe 官方直连    → https://api.typesafe.ai
#                                候补名单，console.typesafe.ai/settings/keys
#
# Jev 是判断模型，**不生成文本**，只回答类型化问题（choice / score / noul）。
# 它给出的是情绪概率分布、强度、视线、待机基调、要不要中途移开视线。

JEV_KEY=vck_...

# 下面三个一般不用填，自动识别的结果不对时才覆盖
# JEV_BACKEND=vercel          # vercel | jevstation | typesafe
# JEV_BASE_URL=               # 自部署或自建网关时改
# JEV_MODEL=typesafe-ai/jev   # Vercel 必须带；JevStation 会忽略

# 倾听反应：用户话音刚落时先让 Jev 判断角色的第一反应（和写台词并行），
# 角色会先有表情再开口。每轮多 1 次评估（1 credit），不想要就关掉：
# JEV_REACTION=off


# ------------------------------------------------------------
# 输入层：DeepSeek —— 决定"说什么"
# ------------------------------------------------------------
# 一期用它替代实时语音交互。人设写在 server/persona.md。
# 不配的话回落到前端的规则模板（能跑，但台词是写死的）。

DEEPSEEK_API_KEY=sk-...

# 可选。默认 deepseek-flash —— 实时对话里延迟直接决定观感。
# 要更好的对话质量可以换 deepseek-v4-pro，代价是慢。
# DEEPSEEK_MODEL=deepseek-flash

# 可选。默认不发 thinking / reasoning_effort，走最朴素的兼容形状。
# 填了才会开推理（会明显变慢，对话场景一般不需要）。
# DEEPSEEK_REASONING_EFFORT=high

# 可选，自建网关时改
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。强制用规则模板，不走 DeepSeek（想对比时用）
# JEV_SPEECH=draft


# ------------------------------------------------------------
# 语音：千问 Qwen3-TTS —— 决定"用什么声音说"
# ------------------------------------------------------------
# 远程（推荐）：填千问的 key 就会用它，不占本机内存。千问 AI 平台、阿里云百炼的 key 都可以，
# 接口地址自动探测（也可以用 DASHSCOPE_BASE_URL 指定）。
DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com   # 千问 AI 平台；百炼北京 https://dashscope.aliyuncs.com
# QWEN_TTS_MODEL=qwen3-tts-instruct-flash             # 支持语气指令，一句话里按段换语气要靠它
# TTS_SPEAKER=Vivian                                   # 默认音色（界面下拉框没选过时用）

# 本地（备选）：本机跑 tts/server.py（Apple Silicon，4.5~9GB 内存）。没配千问 key 时自动用它
# TTS_BACKEND=local            # 有 key 也强制用本地
# TTS=off                      # 完全不用，回落到浏览器的系统语音
# TTS_AUTOSTART=off            # 本地后端不自动启动（另开终端 npm run tts）
# TTS_URL=http://127.0.0.1:8765
# TTS_DESIGN_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16


# ------------------------------------------------------------
# 替代方案：你自己的 HTTP 服务（输入层+判断层都自己做）
# ------------------------------------------------------------
# 契约：POST {input, history, draft} -> ActScript（见 src/act/schema.ts）
# UI 右侧「Act IR 契约」面板有完整字段说明。

# JEV_MODE=passthrough
# JEV_ENDPOINT=http://localhost:8787/act
# JEV_API_KEY=
# JEV_AUTH_HEADER=Authorization

# ---- 腾讯混元生 3D：文生动作（server/tencent3d.ts、server/motionGen.ts）----
# 云 API 密钥（SecretId + SecretKey，签名 v3），在 https://console.cloud.tencent.com/cam/capi 创建。
# 注意：充值的余额不会自动用在混元生 3D 上，要在控制台领免费积分 / 开通后付费 / 买资源包。
# 文生动作每次 10 积分（和时长无关，失败不扣）。
TENCENTCLOUD_SECRET_ID=AKID...
TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-guangzhou
