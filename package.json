{
  "name": "jevdemo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "motion": "vite --config motion-workbench/vite.config.ts",
    "motion:check": "tsc -p motion-workbench/tsconfig.json && node --experimental-strip-types --test motion-workbench/server/*.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tts": "tts/.venv/bin/python tts/server.py",
    "assets": "node scripts/fetch-scene-assets.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "postprocessing": "^6.38.2",
    "three-good-godrays": "0.12.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "three-good-godrays": {
      "three": "$three"
    },
    "postprocessing": {
      "three": "$three"
    }
  }
}
