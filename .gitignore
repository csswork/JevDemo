# 本地 TTS（Qwen3-TTS via mlx-audio）：虚拟环境和生成的音频不进仓库
tts/.venv/
tts/out/

# 候选模型（对比用，不进仓库）
public/models/candidates/
# 开发工具存的对比图（server/devSave.ts）
dev-out/
# 聊天记录（server/chatStore.ts）：每个模型一个 session，不进仓库
data/
# VRoid 官方动作包（VRMA_MotionPack）：规约禁止以可提取的形式再分发，不进仓库
public/motions/

# PMX → VRM 转换脚本（scripts/pmx2vrm/）：Blender 跑脚本时生成的字节码
__pycache__/
# 转换出来的明文 VRM 绝不入库（QUAPPA-EL 规约要求防再利用），仓库里只放加密后的 .vrmx
public/models/quappa/*.vrm
